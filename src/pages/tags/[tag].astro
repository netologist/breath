---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { url } from '../../utils/url';
import { formatYMD, getEffectiveDate, sortByDate } from '../../utils/date';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const allNotes = await getCollection('notes');

  const tagSet = new Set<string>();
  allPosts.forEach(p => (p.data.tags ?? []).forEach(t => tagSet.add(t)));
  allNotes.forEach(n => (n.data.tags ?? []).forEach(t => tagSet.add(t)));

  return Array.from(tagSet).map(tag => {
    const posts = sortByDate(
      allPosts.filter(p => (p.data.tags ?? []).includes(tag)),
      'updated'
    );

    const notes = sortByDate(
      allNotes.filter(n => (n.data.tags ?? []).includes(tag)),
      'updated'
    );

    return {
      params: { tag },
      props: { tag, posts, notes },
    };
  });
}

const { tag, posts, notes } = Astro.props;

const stageLabel = { seedling: '🌱 Seedling', budding: '🌿 Budding', evergreen: '🌲 Evergreen' };
const stageCls   = { seedling: 'stage-seedling', budding: 'stage-budding', evergreen: 'stage-evergreen' };
---

<BaseLayout title={`#${tag} — Tag`} description={`Articles and notes tagged #${tag}.`}>
  <Sidebar />

  <main class="site-content">
    <div class="tag-page-header">
      <div class="tag-breadcrumb">
        <a href={url('/tags')}>← All Tags</a>
      </div>
      <h2 class="page-title">
        <span class="tag-hash">#</span>{tag}
        <span class="count">{posts.length + notes.length}</span>
      </h2>
    </div>

    <!-- 1. Articles -->
    {posts.length > 0 && (
      <section class="tag-section">
        <h3 class="section-title">
          <span class="section-icon">📝</span> Articles
          <span class="section-count">({posts.length})</span>
        </h3>
        <ul class="listing">
          {posts.map(post => {
            const d = getEffectiveDate(post, 'updated');
            return (
              <li>
                <a href={url(`/blog/${post.id}`)}>{post.data.title}</a>
                <time datetime={d.toISOString()}>{formatYMD(d)}</time>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <!-- 2. Notes -->
    {notes.length > 0 && (
      <section class="tag-section">
        <h3 class="section-title">
          <span class="section-icon">🌲</span> Notes
          <span class="section-count">({notes.length})</span>
        </h3>
        <ul class="listing note-listing">
          {notes.map(note => {
            const d = getEffectiveDate(note, 'updated');
            return (
              <li>
                <span class={`stage-badge-small ${stageCls[note.data.stage]}`}>
                  {stageLabel[note.data.stage]}
                </span>
                <a href={url(`/notes/${note.id}`)}>{note.data.title}</a>
                <time datetime={d.toISOString()}>{formatYMD(d)}</time>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {posts.length === 0 && notes.length === 0 && (
      <p class="empty-msg">No content found with this tag.</p>
    )}
  </main>
</BaseLayout>

<style>
  .tag-page-header {
    margin-bottom: var(--space-xl);
  }
  .tag-breadcrumb {
    margin-bottom: var(--space-sm);
  }
  .tag-breadcrumb a {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .tag-breadcrumb a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }
  .tag-hash {
    color: var(--text-muted);
    font-weight: 400;
  }
  .tag-section {
    margin-bottom: var(--space-xl);
  }
  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--space-sm) 0;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .section-icon {
    font-size: 0.9em;
  }
  .stage-badge-small {
    font-size: 0.72rem;
    padding: 1px 5px;
    border-radius: 2px;
    font-weight: 500;
    line-height: 1.2;
    flex-shrink: 0;
    margin-right: 6px;
  }
  .empty-msg {
    color: var(--text-muted);
    font-style: italic;
    padding: var(--space-xl) 0;
  }
</style>
