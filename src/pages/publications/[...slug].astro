---
import { render } from 'astro:content';
import { getSafeCollection } from '../../utils/content-helpers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { url } from '../../utils/url';
import { formatYMD } from '../../utils/date';

export async function getStaticPaths() {
  const allPubs = await getSafeCollection('publications');
  if (allPubs.length === 0) return [];

  const sorted = [...allPubs].sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

  return [
    { params: { slug: undefined }, props: { isIndex: true, items: sorted } },
    ...sorted.map((item) => ({
      params: { slug: item.id },
      props: { isIndex: false, item, items: sorted },
    })),
  ];
}

const { isIndex, items, item } = Astro.props;

let Content: any = null;
if (!isIndex && item) {
  const rendered = await render(item);
  Content = rendered.Content;
}
---

{isIndex ? (
  <BaseLayout title="Publications" description="Academic papers, journal publications, and technical writing.">
    <Sidebar />
    <main class="site-content">
      <div class="header-bar">
        <h2 class="page-title">
          publications
          <span class="count">{items.length}</span>
        </h2>
        <p class="page-desc">Academic papers, peer-reviewed articles, books, and technical research.</p>
      </div>

      <div class="pubs-grid">
        {items.map((pub: any) => {
          const hasBody = Boolean(pub.body && pub.body.trim().length > 0);
          const targetUrl = pub.data.url || pub.data.pdfUrl || (hasBody ? url(`/publications/${pub.id}`) : null);

          return (
            <article class={`pub-card ${pub.data.featured ? 'is-featured' : ''}`}>
              <div class="pub-header">
                <div class="pub-meta-row">
                  {pub.data.venue && <span class="venue-badge">{pub.data.venue}</span>}
                </div>
                {pub.data.date && (
                  <time class="pub-date" datetime={pub.data.date.toISOString()}>
                    {formatYMD(pub.data.date)}
                  </time>
                )}
              </div>

              <h3 class="pub-title">
                {targetUrl ? (
                  <a href={targetUrl} target={targetUrl.startsWith('http') ? '_blank' : undefined} rel={targetUrl.startsWith('http') ? 'noopener' : undefined}>
                    {pub.data.title}
                  </a>
                ) : (
                  <span>{pub.data.title}</span>
                )}
              </h3>

              {pub.data.authors && pub.data.authors.length > 0 && (
                <p class="pub-authors">
                  {pub.data.authors.join(', ')}
                </p>
              )}

              {pub.data.description && <p class="pub-desc">{pub.data.description}</p>}

              {pub.data.tags && pub.data.tags.length > 0 && (
                <div class="pub-tags">
                  {pub.data.tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}

              <div class="pub-links">
                {pub.data.url && (
                  <a href={pub.data.url} target="_blank" rel="noopener noreferrer" class="pub-link">
                    Read Publication
                  </a>
                )}
                {pub.data.pdfUrl && (
                  <a href={pub.data.pdfUrl} target="_blank" rel="noopener noreferrer" class="pub-link pdf-link">
                    PDF Download
                  </a>
                )}
                {pub.data.doi && (
                  <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer" class="pub-link doi-link">
                    DOI: {pub.data.doi}
                  </a>
                )}
                {hasBody && (
                  <a href={url(`/publications/${pub.id}`)} class="pub-link notes-link">
                    Abstract & Notes
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title={item.data.title} description={item.data.description}>
    <Sidebar />
    <main class="site-content">
      <div class="breadcrumb">
        <a href={url('/publications')}>← back to publications</a>
      </div>

      <header class="detail-header">
        <h1 class="page-title">{item.data.title}</h1>

        <div class="detail-meta">
          {item.data.venue && <span class="venue-badge">{item.data.venue}</span>}
          {item.data.date && (
            <time class="detail-date" datetime={item.data.date.toISOString()}>
              {formatYMD(item.data.date)}
            </time>
          )}
        </div>

        {item.data.authors && item.data.authors.length > 0 && (
          <p class="pub-authors detail-authors">
            <strong>Authors:</strong> {item.data.authors.join(', ')}
          </p>
        )}

        {item.data.description && <p class="page-desc">{item.data.description}</p>}

        <div class="detail-actions">
          {item.data.url && (
            <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="btn-action">
              Read Publication
            </a>
          )}
          {item.data.pdfUrl && (
            <a href={item.data.pdfUrl} target="_blank" rel="noopener noreferrer" class="btn-action">
              PDF Download
            </a>
          )}
          {item.data.doi && (
            <a href={`https://doi.org/${item.data.doi}`} target="_blank" rel="noopener noreferrer" class="btn-action">
              DOI: {item.data.doi}
            </a>
          )}
        </div>

        {item.data.tags && item.data.tags.length > 0 && (
          <div class="pub-tags">
            {item.data.tags.map((t: string) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )}
      </header>

      <hr class="detail-separator" />

      {Content && (
        <article class="prose">
          <Content />
        </article>
      )}
    </main>
  </BaseLayout>
)}

<style>
  .header-bar {
    margin-bottom: var(--space-xl);
  }

  .pubs-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .pub-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-md) var(--space-lg);
    transition: border-color var(--transition);
  }

  .pub-card:hover {
    border-color: var(--border-hover);
  }

  .pub-card.is-featured {
    border-left: 3px solid var(--title-accent);
  }

  .pub-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
  }

  .venue-badge {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 1px 7px;
    border-radius: var(--radius);
    color: var(--text-primary);
  }

  .pub-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .pub-title {
    font-size: var(--text-md);
    margin: var(--space-xs) 0;
  }

  .pub-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .pub-title a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }

  .pub-authors {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: var(--space-xs);
  }

  .detail-authors {
    margin-top: var(--space-sm);
    font-size: var(--text-base);
    color: var(--text-secondary);
  }

  .pub-desc {
    color: var(--text-secondary);
    font-size: var(--text-base);
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: 1.5;
  }

  .pub-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: var(--space-sm) 0;
  }

  .pub-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    flex-wrap: wrap;
  }

  .pub-link {
    color: var(--text-link);
    text-decoration: none;
    font-weight: 500;
  }

  .pub-link:hover {
    text-decoration: underline;
  }

  /* Detail styles */
  .breadcrumb {
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }

  .detail-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-xs) 0 var(--space-sm);
    flex-wrap: wrap;
  }

  .detail-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .detail-actions {
    display: flex;
    gap: var(--space-sm);
    margin: var(--space-md) 0;
    flex-wrap: wrap;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all var(--transition);
  }

  .btn-action:hover {
    border-color: var(--border-hover);
    color: var(--text-link);
    text-decoration: none;
  }

  .detail-separator {
    margin: var(--space-lg) 0;
  }
</style>
