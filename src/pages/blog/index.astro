---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  const y = post.data.date.getFullYear().toString();
  (byYear[y] ??= []).push(post);
}
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

// Tag cloud
const tagCounts: Record<string, number> = {};
allPosts.forEach(p => p.data.tags.forEach(t => { tagCounts[t] = (tagCounts[t] ?? 0) + 1; }));
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

function shortDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

<BaseLayout title="Writing" description="Articles on software engineering, distributed systems, and design.">
  <Sidebar />

  <main class="site-content">
    <h2 class="page-title">writing <span class="count">{allPosts.length}</span></h2>
    <p class="page-desc">Essays, engineering guides, and deep technical notes.</p>

    {tags.length > 0 && (
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${tag}`} class="tag">
            {tag} <span class="tag-count">({count})</span>
          </a>
        ))}
      </div>
    )}

    {years.map(year => (
      <section>
        <p class="year-heading">{year}</p>
        <ul class="listing">
          {byYear[year].map(post => (
            <li>
              <time datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 0.35em;
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    margin-bottom: var(--space-xl);
  }
</style>
