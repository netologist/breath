---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { url } from '../../utils/url';
import { formatYMD, getEffectiveDate } from '../../utils/date';
import { slugifySeries } from '../../utils/series';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  const seriesMap = new Map<string, { name: string; slug: string; posts: typeof allPosts }>();

  for (const post of allPosts) {
    if (!post.data.series) continue;
    const name = post.data.series;
    const slug = slugifySeries(name);

    if (!seriesMap.has(slug)) {
      seriesMap.set(slug, { name, slug, posts: [] });
    }
    seriesMap.get(slug)!.posts.push(post);
  }

  return Array.from(seriesMap.values()).map(({ name, slug, posts }) => {
    const sorted = [...posts].sort((a, b) => {
      const orderA = a.data.seriesOrder ?? 999;
      const orderB = b.data.seriesOrder ?? 999;
      if (orderA !== orderB) return orderA - orderB;
      return getEffectiveDate(a).getTime() - getEffectiveDate(b).getTime();
    });

    return {
      params: { series: slug },
      props: { seriesName: name, posts: sorted },
    };
  });
}

const { seriesName, posts } = Astro.props;
---

<BaseLayout title={`« ${seriesName} » — Series`} description={`Articles in the ${seriesName} series.`}>
  <Sidebar />

  <main class="site-content">
    <div class="series-page-header">
      <div class="series-breadcrumb">
        <a href={url('/series')}>← All Series</a>
      </div>
      <h2 class="page-title">
        « {seriesName} »
        <span class="count">{posts.length}</span>
      </h2>
    </div>

    <!-- 1. Articles Grouped -->
    {posts.length > 0 && (
      <section class="series-section">
        <h3 class="section-title">
          <span class="section-icon">📝</span> Articles
          <span class="section-count">({posts.length})</span>
        </h3>
        <ul class="listing">
          {posts.map((post, i) => {
            const d = post.data.updated || post.data.date;
            const orderNum = post.data.seriesOrder ?? (i + 1);
            return (
              <li>
                <span class="order-num">#{String(orderNum).padStart(2, '0')}</span>
                <a href={url(`/blog/${post.id}`)}>{post.data.title}</a>
                {d && <time datetime={d.toISOString()}>{formatYMD(d)}</time>}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {posts.length === 0 && (
      <p class="empty-msg">No articles found in this series.</p>
    )}
  </main>
</BaseLayout>

<style>
  .series-page-header {
    margin-bottom: var(--space-xl);
  }
  .series-breadcrumb {
    margin-bottom: var(--space-sm);
  }
  .series-breadcrumb a {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .series-breadcrumb a:hover {
    color: var(--text-link);
    text-decoration: underline;
  }
  .series-section {
    margin-bottom: var(--space-xl);
  }
  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--space-sm) 0;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .section-icon {
    font-size: 0.9em;
  }
  .section-count {
    color: var(--text-muted);
    font-weight: 400;
    font-size: var(--text-sm);
  }
  .order-num {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    min-width: 28px;
    display: inline-block;
  }
  .empty-msg {
    color: var(--text-muted);
    font-style: italic;
    padding: var(--space-xl) 0;
  }
</style>
