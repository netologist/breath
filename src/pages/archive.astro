---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  const y = post.data.date.getFullYear().toString();
  (byYear[y] ??= []).push(post);
}
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

function longDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout title="Archive" description="Chronological timeline of all published posts.">
  <Sidebar />
  <main class="site-content">
    <h2 class="page-title">
      archive
      <span class="count">{allPosts.length}</span>
    </h2>
    <p class="page-desc">Complete chronological archive of all published posts.</p>

    {years.map(year => (
      <section>
        <p class="year-heading">{year} <span class="ycount">({byYear[year].length})</span></p>
        <ul class="listing">
          {byYear[year].map(post => (
            <li>
              <time datetime={post.data.date.toISOString()}>{longDate(post.data.date)}</time>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .page-title { margin-bottom: 0.35em; }
  .ycount     { font-weight: 400; }
  .listing time { min-width: 110px; }
</style>
