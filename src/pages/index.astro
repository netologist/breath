---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../utils/url';
import { formatYMD, getEffectiveDate, groupByYear } from '../utils/date';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const { years, byYear } = groupByYear(allPosts, 'updated');
---

<BaseLayout title="Breath" description="A minimalist digital garden and engineering blog.">
  <Sidebar />

  <main class="site-content">
    <div class="blog-header-bar">
      <h3 class="blog-title">
        <span class="prompt">$ tail -f /var/log/thoughts</span>
      </h3>
    </div>

    {years.map(year => (
      <section>
        <p class="year-heading">{year}</p>
        <ul class="listing">
          {byYear[year].map(post => {
            const effDate = getEffectiveDate(post, 'updated');
            return (
              <li>
                <a href={url(`/blog/${post.id}`)}>{post.data.title}</a>
                <time datetime={effDate.toISOString()}>
                  {formatYMD(effDate)}
                </time>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .blog-header-bar {
    margin-bottom: var(--space-xl);
  }

  .blog-title {
    margin: 0;
    line-height: 1.1;
    font-family: var(--font-main);
  }

  .prompt {
    font-size: 1.95rem;
    font-weight: 700;
    color: rgb(187, 34, 34);
    letter-spacing: -0.01em;
  }
</style>
