---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../utils/url';
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.series !== b.data.series) return (a.data.series ?? '').localeCompare(b.data.series ?? '');
    return (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0);
  });

const bySeries: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  if (!post.data.series) continue;
  (bySeries[post.data.series] ??= []).push(post);
}
const seriesList = Object.keys(bySeries).sort();
---

<BaseLayout title="Series" description="Multi-part article series and curated deep dives.">
  <Sidebar />
  <main class="site-content">
    <h2 class="page-title">
      series
      <span class="count">{seriesList.length}</span>
    </h2>
    <p class="page-desc">Multi-part technical deep dives and structured learning paths.</p>

    {seriesList.length === 0 && (
      <p class="empty">No article series available yet.</p>
    )}

    {seriesList.map(series => (
      <section class="series-section">
        <p class="year-heading">{series}</p>
        <ol class="listing series-listing">
          {bySeries[series].map((post, i) => (
            <li>
              <time datetime={post.data.date.toISOString()}>
                {String(i + 1).padStart(2, '0')}.
              </time>
              <a href={url(`/blog/${post.id}`)}>{post.data.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .page-title   { margin-bottom: 0.35em; }
  .series-section { margin-bottom: var(--space-xl); }
  .empty        { color: var(--text-muted); font-style: italic; font-size: var(--text-sm); }

  .series-listing time {
    min-width: 28px;
    font-weight: 700;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
