---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../utils/url';
import { slugifySeries } from '../utils/series';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const seriesMap: Record<string, { name: string; slug: string; count: number }> = {};

for (const post of allPosts) {
  if (!post.data.series) continue;
  const name = post.data.series;
  const slug = slugifySeries(name);
  if (!seriesMap[slug]) {
    seriesMap[slug] = { name, slug, count: 0 };
  }
  seriesMap[slug].count += 1;
}

const seriesList = Object.values(seriesMap).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout title="Series" description="Multi-part article series and curated deep dives.">
  <Sidebar />
  <main class="site-content">
    <h2 class="page-title">
      series
      <span class="count">{seriesList.length}</span>
    </h2>
    <p class="page-desc">Multi-part technical deep dives and structured learning paths.</p>

    {seriesList.length === 0 && (
      <p class="empty">No article series available yet.</p>
    )}

    <div class="series-grid">
      {seriesList.map(s => (
        <a href={url(`/series/${s.slug}`)} class="series-card">
          <span class="series-name">{s.name}</span>
          <span class="series-meta">{s.count} {s.count === 1 ? 'part' : 'parts'}</span>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .page-title { margin-bottom: 0.35em; }
  .empty { color: var(--text-muted); font-style: italic; font-size: var(--text-sm); }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    margin-top: var(--space-md);
  }

  .series-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition);
  }

  .series-card:hover {
    border-color: var(--text-link);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .series-name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
  }

  .series-card:hover .series-name {
    color: var(--text-link);
  }

  .series-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .series-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
