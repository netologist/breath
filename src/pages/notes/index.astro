---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { url, base } from '../../utils/url';
import { formatYMD, getEffectiveDate, sortByDate } from '../../utils/date';
import { isPrivateNote } from '../../utils/notes';
const allNotes = await getCollection('notes');

// Fetch and render the flagship garden entry note
const gardenEntry = await getEntry('notes', 'garden');
let GardenContent = null;
if (gardenEntry) {
  const rendered = await render(gardenEntry);
  GardenContent = rendered.Content;
}

// Sort remaining notes by growth stage
const stageOrder = { evergreen: 0, budding: 1, seedling: 2 };
const directoryNotes = allNotes
  .filter(n => n.id !== 'garden' && !isPrivateNote(n))
  .sort((a, b) => stageOrder[a.data.stage] - stageOrder[b.data.stage]);

const byStage = {
  evergreen: sortByDate(directoryNotes.filter(n => n.data.stage === 'evergreen'), 'updated'),
  budding:   sortByDate(directoryNotes.filter(n => n.data.stage === 'budding'), 'updated'),
  seedling:  sortByDate(directoryNotes.filter(n => n.data.stage === 'seedling'), 'updated'),
};
const stageLabel = { evergreen: '🌲 Evergreen Notes', budding: '🌿 Budding Ideas', seedling: '🌱 Seedling Thoughts' };
const stageCls   = { evergreen: 'stage-evergreen', budding: 'stage-budding', seedling: 'stage-seedling' };

const tagCounts: Record<string, number> = {};
allNotes.filter(n => !isPrivateNote(n)).forEach(n => n.data.tags.forEach(t => { tagCounts[t] = (tagCounts[t] ?? 0) + 1; }));
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Digital Garden" description="A collection of evergreen notes, connected thoughts, and evolving ideas.">
  <Sidebar />

  <main class="site-content garden-main">
    <!-- Garden Header -->
    <div class="garden-header">
      <h2 class="page-title">
        digital garden
        <span class="count">{allNotes.length}</span>
      </h2>
      <p class="page-desc">
        A public workspace where ideas grow from rough seedlings into evergreen notes through interconnected thinking.
      </p>
    </div>

    <!-- 1. Flagship Garden Intro Note with Wikilinks -->
    {gardenEntry && GardenContent && (
      <section class="garden-intro-card">
        <div class="garden-card-meta">
          <span class="stage-badge stage-evergreen">🌲 Garden Overview</span>
          <span class="meta-sep">·</span>
          <span class="garden-card-hint">hover or tap wikilinks to preview connected notes</span>
        </div>

        <h3 class="garden-intro-title">{gardenEntry.data.title}</h3>

        <div class="prose garden-prose">
          <GardenContent />
        </div>

        {gardenEntry.data.tags.length > 0 && (
          <div class="garden-intro-tags">
            <span class="tags-label">tags:</span>
            {gardenEntry.data.tags.map(tag => (
              <a href={url(`/tags/${tag}`)} class="tag">{tag}</a>
            ))}
          </div>
        )}
      </section>
    )}

    <!-- 2. Search Box -->
    <div class="search-section">
      <div class="search-box">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="note-search-input"
          class="search-input"
          placeholder="Search notes (title, tags, content)..."
          autocomplete="off"
          aria-label="Search notes"
        />
        <button id="search-clear-btn" class="search-clear-btn" aria-label="Clear search" style="display: none;">✕</button>
      </div>
      <div id="search-status" class="search-status" aria-live="polite"></div>
    </div>

    <!-- 3. Tag Cloud -->
    {tags.length > 0 && (
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a href={url(`/tags/${tag}`)} class="tag">
            {tag} <span class="tag-count">({count})</span>
          </a>
        ))}
      </div>
    )}

    <!-- 4. Notes Directory (by growth stage) -->
    <div id="notes-content-container">
      <h3 class="directory-heading">All Notes & Ideas</h3>

      {(Object.keys(byStage) as Array<keyof typeof byStage>).map(stage =>
        byStage[stage].length > 0 && (
          <section class="stage-section" data-stage={stage}>
            <p class="year-heading">
              <span class={`stage-badge ${stageCls[stage]}`}>{stageLabel[stage]}</span>
              <span class="stage-count">({byStage[stage].length})</span>
            </p>
            <ul class="listing note-listing">
              {byStage[stage].map(note => {
                const d = getEffectiveDate(note, 'updated');
                return (
                  <li class="note-list-item" data-title={note.data.title.toLowerCase()} data-tags={note.data.tags.join(' ').toLowerCase()} data-desc={(note.data.description ?? '').toLowerCase()}>
                    <div class="note-item-main">
                      <a href={url(`/notes/${note.id}`)} class="note-link" data-note-id={note.id}>
                        <span class="note-bullet">·</span>
                        <span class="note-title-text">{note.data.title}</span>
                      </a>
                      {note.data.description && (
                        <span class="note-item-desc">{note.data.description}</span>
                      )}
                    </div>
                    <time datetime={d.toISOString()} class="note-item-date">{formatYMD(d)}</time>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      )}
    </div>

    <div id="no-search-results" class="no-results" style="display: none;">
      <p>No notes matching your search query.</p>
    </div>
  </main>

  <!-- Interactive Note Hover Popover Preview -->
  <div id="note-popover" class="note-popover" aria-hidden="true">
    <div class="popover-content">
      <div class="popover-meta">
        <span id="popover-stage" class="stage-badge"></span>
        <span class="popover-hint">click to open in side panel ↗</span>
      </div>
      <h4 id="popover-title" class="popover-title"></h4>
      <p id="popover-desc" class="popover-desc"></p>
      <div id="popover-tags" class="popover-tags"></div>
    </div>
  </div>

  <!-- Andy Matuschak Style Stacked Note Drawer -->
  <div id="note-drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>
  <aside id="note-drawer" class="note-drawer" aria-label="Note Preview Panel" aria-hidden="true">
    <div class="drawer-header">
      <div class="drawer-controls">
        <span class="drawer-badge">Evergreen Note</span>
        <a id="drawer-full-link" href="#" class="drawer-full-btn" title="Open full note">↗ Open Full Note</a>
      </div>
      <button id="drawer-close-btn" class="drawer-close-btn" aria-label="Close preview">✕</button>
    </div>
    <div id="drawer-body" class="drawer-body"></div>
  </aside>
</BaseLayout>

<script>
  interface NoteData {
    id: string;
    title: string;
    description: string;
    stage: 'seedling' | 'budding' | 'evergreen';
    tags: string[];
    category: string;
    created: string;
    updated: string | null;
  }

  const stageLabel: Record<string, string> = { seedling: '🌱 Seedling', budding: '🌿 Budding', evergreen: '🌲 Evergreen' };
  const stageCls: Record<string, string> = { seedling: 'stage-seedling', budding: 'stage-budding', evergreen: 'stage-evergreen' };

  let notesMap = new Map<string, NoteData>();
  const noteCache = new Map<string, string>();

  // Fetch notes metadata for instant search and popover previews
  const apiNotesUrl = (document.querySelector('meta[name="astro-base"]') as HTMLMetaElement)?.content || `${window.location.pathname.startsWith('/breath') ? '/breath' : ''}/api/notes.json`;
  fetch(apiNotesUrl)
    .then((data: NoteData[]) => {
      data.forEach(note => {
        notesMap.set(note.id, note);
      });
    })
    .catch(() => {});

  // ── Hover Popover ──
  const popover = document.getElementById('note-popover');
  const popoverStage = document.getElementById('popover-stage');
  const popoverTitle = document.getElementById('popover-title');
  const popoverDesc = document.getElementById('popover-desc');
  const popoverTags = document.getElementById('popover-tags');

  let popoverTimer: any = null;
  let activeLink: HTMLElement | null = null;

  function showPopover(link: HTMLElement, note: NoteData) {
    if (!popover || !popoverStage || !popoverTitle || !popoverDesc || !popoverTags) return;

    popoverStage.className = `stage-badge ${stageCls[note.stage] || 'stage-seedling'}`;
    popoverStage.textContent = stageLabel[note.stage] || '🌱 Seedling';
    popoverTitle.textContent = note.title;
    popoverDesc.textContent = note.description || 'No description available.';

    popoverTags.innerHTML = (note.tags || [])
      .map(t => `<span class="tag tag-mini">${t}</span>`)
      .join(' ');

    const rect = link.getBoundingClientRect();
    const popoverWidth = 320;
    const popoverHeight = 160;

    let left = rect.left + window.scrollX;
    let top = rect.bottom + window.scrollY + 8;

    if (left + popoverWidth > window.innerWidth - 20) {
      left = window.innerWidth - popoverWidth - 20;
    }
    if (left < 10) left = 10;

    if (rect.bottom + popoverHeight > window.innerHeight && rect.top > popoverHeight) {
      top = rect.top + window.scrollY - popoverHeight - 8;
    }

    popover.style.left = `${left}px`;
    popover.style.top = `${top}px`;
    popover.classList.add('visible');
    popover.setAttribute('aria-hidden', 'false');
  }

  function hidePopover() {
    if (!popover) return;
    popover.classList.remove('visible');
    popover.setAttribute('aria-hidden', 'true');
    activeLink = null;
  }

  function handleLinkMouseOver(e: MouseEvent) {
    const target = (e.target as HTMLElement).closest('a');
    if (!target) return;

    const href = target.getAttribute('href');
    if (!href) return;

    const match = href.match(/(?:\/breath)?\/notes\/([a-zA-Z0-9_\-\.]+)\/?$/);
    if (match) {
      const noteId = match[1];
      const note = notesMap.get(noteId);
      if (!note) return;

      clearTimeout(popoverTimer);
      activeLink = target;
      popoverTimer = setTimeout(() => {
        showPopover(target, note);
      }, 150);
    }
  }

  function handleLinkMouseOut(e: MouseEvent) {
    const related = e.relatedTarget as HTMLElement | null;
    if (related && (related.closest('#note-popover') || related.closest('a') === activeLink)) {
      return;
    }
    clearTimeout(popoverTimer);
    popoverTimer = setTimeout(hidePopover, 200);
  }

  popover?.addEventListener('mouseleave', () => {
    hidePopover();
  });

  document.addEventListener('mouseover', handleLinkMouseOver);
  document.addEventListener('mouseout', handleLinkMouseOut);

  // ── Drawer Functionality ──
  const drawer = document.getElementById('note-drawer');
  const backdrop = document.getElementById('note-drawer-backdrop');
  const drawerBody = document.getElementById('drawer-body');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const drawerFullLink = document.getElementById('drawer-full-link') as HTMLAnchorElement | null;

  async function loadNoteIntoDrawer(url: string) {
    if (!drawer || !drawerBody) return;

    hidePopover();

    drawer.classList.add('open');
    backdrop?.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    backdrop?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('drawer-open');

    if (drawerFullLink) {
      drawerFullLink.href = url;
    }

    drawerBody.innerHTML = `
      <div class="drawer-loading">
        <div class="drawer-spinner"></div>
        <p>Loading note...</p>
      </div>
    `;

    try {
      let contentHtml = noteCache.get(url);
      if (!contentHtml) {
        const res = await fetch(url);
        if (!res.ok) throw new Error('Could not load note');
        const text = await res.text();
        const doc = new DOMParser().parseFromString(text, 'text/html');
        const article = doc.querySelector('article.note-article') || doc.querySelector('article');
        if (!article) throw new Error('Note content not found');
        contentHtml = article.innerHTML;
        noteCache.set(url, contentHtml);
      }

      drawerBody.innerHTML = contentHtml;
      attachDrawerInternalLinks();
      drawerBody.scrollTop = 0;
    } catch (e) {
      drawerBody.innerHTML = `
        <div class="drawer-error">
          <p>Could not load note preview.</p>
          <a href="${url}" class="drawer-retry-btn">Open Full Note</a>
        </div>
      `;
    }
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('open');
    backdrop?.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    backdrop?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('drawer-open');
  }

  function handleLinkClick(e: MouseEvent) {
    const target = (e.target as HTMLElement).closest('a');
    if (!target) return;

    if (target.id === 'drawer-full-link' || target.classList.contains('drawer-full-btn') || target.classList.contains('drawer-retry-btn')) {
      return;
    }

    const href = target.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto:')) return;

    const match = href.match(/(?:\/breath)?\/notes\/([a-zA-Z0-9_\-\.]+)\/?$/);
    if (match) {
      if (window.location.pathname === href || window.location.pathname === `${href}/`) {
        return;
      }
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      e.preventDefault();
      loadNoteIntoDrawer(href);
    }
  }

  function attachDrawerInternalLinks() {
    if (!drawerBody) return;
    const links = drawerBody.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', handleLinkClick as EventListener);
    });
  }

  document.addEventListener('click', handleLinkClick as EventListener);
  drawerCloseBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (drawer?.classList.contains('open')) {
        closeDrawer();
      }
      hidePopover();
    }
  });

  // ── Search Logic ──
  const searchInput = document.getElementById('note-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('search-clear-btn');
  const searchStatus = document.getElementById('search-status');
  const noResults = document.getElementById('no-search-results');
  const noteItems = document.querySelectorAll('.note-list-item') as NodeListOf<HTMLElement>;
  const stageSections = document.querySelectorAll('.stage-section') as NodeListOf<HTMLElement>;

  function performSearch() {
    if (!searchInput) return;
    const query = searchInput.value.trim().toLowerCase();

    if (clearBtn) {
      clearBtn.style.display = query ? 'block' : 'none';
    }

    if (!query) {
      noteItems.forEach(item => (item.style.display = ''));
      stageSections.forEach(section => (section.style.display = ''));
      if (noResults) noResults.style.display = 'none';
      if (searchStatus) searchStatus.textContent = '';
      return;
    }

    let matchCount = 0;

    noteItems.forEach(item => {
      const title = item.dataset.title || '';
      const tags = item.dataset.tags || '';
      const desc = item.dataset.desc || '';
      const isMatch = title.includes(query) || tags.includes(query) || desc.includes(query);

      if (isMatch) {
        item.style.display = '';
        matchCount++;
      } else {
        item.style.display = 'none';
      }
    });

    stageSections.forEach(section => {
      const visibleItems = section.querySelectorAll('.note-list-item:not([style*="display: none"])');
      section.style.display = visibleItems.length > 0 ? '' : 'none';
    });

    if (noResults) {
      noResults.style.display = matchCount === 0 ? 'block' : 'none';
    }

    if (searchStatus) {
      searchStatus.textContent = matchCount > 0 ? `${matchCount} note${matchCount === 1 ? '' : 's'} found` : 'No notes found';
    }
  }

  searchInput?.addEventListener('input', performSearch);
  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      performSearch();
      searchInput.focus();
    }
  });
</script>

<style>
  .garden-header {
    margin-bottom: var(--space-xl);
  }

  .garden-intro-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    margin-bottom: var(--space-xl);
    position: relative;
  }
  .garden-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .garden-card-hint {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-style: italic;
  }
  .garden-intro-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 12px 0;
    line-height: 1.25;
  }
  .garden-prose {
    font-size: var(--text-base);
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .garden-intro-tags {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .tags-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ── Search Bar ── */
  .search-section {
    margin-bottom: var(--space-lg);
  }
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 10px 36px 10px 38px;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .search-input:focus {
    border-color: var(--text-link);
    box-shadow: 0 0 0 2px rgba(34, 124, 232, 0.15);
  }
  .search-clear-btn {
    position: absolute;
    right: 10px;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 14px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 50%;
    transition: color var(--transition);
  }
  .search-clear-btn:hover {
    color: var(--text-primary);
  }
  .search-status {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: 6px;
    min-height: 1.2em;
    font-style: italic;
  }

  /* ── Tag Cloud ── */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    margin-bottom: var(--space-xl);
  }
  .tag-mini {
    font-size: 0.75rem;
    padding: 0 4px;
    line-height: 1.3;
    opacity: 0.85;
  }

  /* ── Directory Listings ── */
  .directory-heading {
    font-size: 1.4rem;
    font-weight: 700;
    color: #b22;
    margin-bottom: var(--space-md);
  }
  .stage-section {
    margin-bottom: var(--space-lg);
  }
  .stage-section .year-heading {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .note-listing {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .note-list-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px dotted var(--border);
  }
  .note-list-item:last-child {
    border-bottom: none;
  }
  .note-item-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex: 1;
    min-width: 0;
    flex-wrap: wrap;
  }
  .note-link {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--text-link);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    flex-shrink: 0;
  }
  .note-link:hover {
    text-decoration: underline;
    color: var(--text-link-hover);
  }
  .note-bullet {
    color: var(--text-muted);
    font-weight: bold;
    user-select: none;
  }
  .note-item-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-style: italic;
  }
  .note-item-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    flex-shrink: 0;
    text-align: right;
    letter-spacing: 0.02em;
  }
  .note-bullet {
    color: var(--text-muted);
    font-weight: bold;
    user-select: none;
  }
  .note-item-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-style: italic;
    flex: 1;
    min-width: 180px;
  }
  .note-item-tags {
    display: inline-flex;
    gap: 4px;
  }

  .no-results {
    padding: var(--space-xl) 0;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-sans);
    text-align: center;
  }

  /* ── Interactive Note Popover Preview ── */
  .note-popover {
    position: absolute;
    z-index: 950;
    width: 320px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    padding: 14px 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    pointer-events: none;
  }
  .note-popover.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .popover-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .popover-hint {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .popover-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px 0;
    line-height: 1.3;
  }
  .popover-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.4;
    margin-bottom: 8px;
  }
  .popover-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  /* ── Andy Matuschak Style Stacked Note Drawer ── */
  .drawer-backdrop {
    position: fixed;
