---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../utils/url';
import { isPrivateNote } from '../utils/notes';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const allNotes = (await getCollection('notes')).filter(n => !isPrivateNote(n));

interface CategoryStat {
  name: string;
  posts: number;
  notes: number;
  total: number;
}

const catMap: Record<string, CategoryStat> = {};

for (const post of allPosts) {
  const cat = post.data.category ?? 'general';
  catMap[cat] ??= { name: cat, posts: 0, notes: 0, total: 0 };
  catMap[cat].posts += 1;
  catMap[cat].total += 1;
}

for (const note of allNotes) {
  const cat = note.data.category ?? 'general';
  catMap[cat] ??= { name: cat, posts: 0, notes: 0, total: 0 };
  catMap[cat].notes += 1;
  catMap[cat].total += 1;
}

const sortedCategories = Object.values(catMap).sort((a, b) => b.total - a.total || a.name.localeCompare(b.name));
---

<BaseLayout title="Categories" description="Index of all articles and evergreen notes organized by topic.">
  <Sidebar />
  <main class="site-content">
    <h2 class="page-title">
      categories
      <span class="count">{sortedCategories.length}</span>
    </h2>
    <p class="page-desc">All articles and digital garden notes organized by category.</p>

    {sortedCategories.length === 0 && (
      <p class="empty">No categories available yet.</p>
    )}

    <div class="category-grid">
      {sortedCategories.map(c => (
        <a href={url(`/categories/${c.name}`)} class="category-card">
          <span class="category-name">{c.name}</span>
          <span class="category-meta">
            {c.posts > 0 && <span>{c.posts} article{c.posts === 1 ? '' : 's'}</span>}
            {c.posts > 0 && c.notes > 0 && <span class="cat-sep">·</span>}
            {c.notes > 0 && <span>{c.notes} note{c.notes === 1 ? '' : 's'}</span>}
          </span>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .page-title { margin-bottom: 0.35em; }
  .empty { color: var(--text-muted); font-style: italic; font-size: var(--text-sm); }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    margin-top: var(--space-md);
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition);
  }

  .category-card:hover {
    border-color: var(--text-link);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .category-name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
  }

  .category-card:hover .category-name {
    color: var(--text-link);
  }

  .category-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .cat-sep {
    color: var(--border);
  }

  @media (max-width: 480px) {
    .category-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
