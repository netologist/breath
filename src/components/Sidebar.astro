---
import { siteConfig } from '../site.config';
import { url } from '../utils/url';

interface Props {
  hasToc?: boolean;
}

const { hasToc = false } = Astro.props;
const { author, social, nav, sourceLink } = siteConfig;

const resolveHref = (href: string) =>
  href.startsWith('http://') || href.startsWith('https://') || href.startsWith('mailto:')
    ? href
    : url(href);

const homeUrl = url('/');
const avatarUrl = author.avatar.startsWith('http') ? author.avatar : url(author.avatar);
const current = Astro.url.pathname;
const isActive = (href: string) => {
  const resolved = resolveHref(href);
  return resolved === homeUrl ? current === homeUrl : current.startsWith(resolved);
};
---

<!-- Mobile Sticky Top Header -->
<header class="mobile-header">
  <div class="mobile-header-left">
    <button
      id="sidebar-toggle-btn"
      class="mobile-menu-btn"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="sidebar-drawer"
    >
      <svg class="hamburger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <a href={homeUrl} class="mobile-brand">
      <img
        src={avatarUrl}
        width="26"
        height="26"
        alt={author.name}
        class="mobile-avatar"
      />
      <span class="mobile-brand-name">{author.name}</span>
    </a>
  </div>

  {hasToc && (
    <div class="mobile-header-right">
      <button
        id="mobile-toc-btn"
        class="mobile-toc-btn"
        type="button"
        aria-label="Open table of contents"
        aria-expanded="false"
        aria-controls="toc-sidebar"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span class="mobile-toc-label">Contents</span>
      </button>
    </div>
  )}
</header>

<!-- Mobile Sidebar Backdrop Overlay -->
<div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

<!-- Sidebar (Desktop Left Sticky Column / Mobile Left Slide-out Drawer) -->
<aside id="sidebar-drawer" class="sidebar" aria-label="Site Navigation">
  <div class="sidebar-drawer-header">
    <span class="sidebar-drawer-title">Menu</span>
    <button
      id="sidebar-close-btn"
      class="sidebar-close-btn"
      type="button"
      aria-label="Close menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="sidebar-identity">
    <a href={homeUrl} class="avatar-link">
      <img
        src={avatarUrl}
        width="80"
        height="80"
        alt={author.name}
        class="avatar"
      />
    </a>
    <a href={homeUrl} class="identity-name">
      <span class="name-main">{author.name}</span>
      {author.nickname && (
        <span class="name-aka">a.k.a @{author.nickname}</span>
      )}
    </a>
  </div>

  <nav class="sidebar-social" aria-label="Social links">
    {social.map((item) => {
      const resolved = resolveHref(item.href);
      const isExt = resolved.startsWith('http');
      return (
        <a
          href={resolved}
          target={isExt ? '_blank' : undefined}
          rel={isExt ? 'noopener' : undefined}
          title={item.label}
          aria-label={item.label}
        >
          {item.platform === 'github' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          )}
          {item.platform === 'linkedin' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          )}
          {(item.platform === 'x' || item.platform === 'twitter') && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter">
              <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
            </svg>
          )}
          {item.platform === 'rss' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          )}
          {item.platform === 'mail' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          )}
          {item.platform === 'youtube' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-youtube">
              <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path>
              <path d="m10 15 5-3-5-3z"></path>
            </svg>
          )}
          {item.platform === 'bluesky' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bluesky">
              <path d="m12 11.5c-1.5-2.5-4.5-6.5-8-6.5-2 0-3 1.5-3 3.5 0 3.5 3 6.5 4.5 7.5-2 .5-4.5.5-4.5 2.5 0 1.5 1.5 2.5 3.5 2.5 3.5 0 6.5-5 7.5-9.5 1 4.5 4 9.5 7.5 9.5 2 0 3.5-1 3.5-2.5 0-2-2.5-2-4.5-2.5 1.5-1 4.5-4 4.5-7.5 0-2-1-3.5-3-3.5-3.5 0-6.5 4-8 6.5z"></path>
            </svg>
          )}
          {!['github', 'linkedin', 'x', 'twitter', 'rss', 'mail', 'youtube', 'bluesky'].includes(item.platform) && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          )}
        </a>
      );
    })}
  </nav>

  <nav class="sidebar-nav" aria-label="Main navigation">
    <ul>
      {nav.map(({ href, label, external }) => {
        const resolved = resolveHref(href);
        const isExt = external || resolved.startsWith('http');
        return (
          <li>
            <a
              href={resolved}
              target={isExt ? '_blank' : undefined}
              rel={isExt ? 'noopener' : undefined}
              class:list={[{ active: isActive(href) }]}
            >
              {label}
            </a>
          </li>
        );
      })}
      {sourceLink && (
        <li class="source-item">
          <a href={sourceLink.href} class="source-link" target="_blank" rel="noopener">
            {sourceLink.label}
          </a>
        </li>
      )}
    </ul>
  </nav>
</aside>

<script>
  function setupMobileSidebar() {
    const sidebar = document.getElementById('sidebar-drawer');
    const backdrop = document.getElementById('sidebar-backdrop');
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const closeBtn = document.getElementById('sidebar-close-btn');
    const navLinks = sidebar?.querySelectorAll('.sidebar-nav a');

    function openSidebar() {
      sidebar?.classList.add('open');
      backdrop?.classList.add('open');
      sidebar?.setAttribute('aria-hidden', 'false');
      backdrop?.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('sidebar-open');
    }

    function closeSidebar() {
      sidebar?.classList.remove('open');
      backdrop?.classList.remove('open');
      sidebar?.setAttribute('aria-hidden', 'true');
      backdrop?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('sidebar-open');
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (sidebar?.classList.contains('open')) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeSidebar();
    });

    backdrop?.addEventListener('click', () => {
      closeSidebar();
    });

    navLinks?.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          closeSidebar();
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
        closeSidebar();
      }
    });
  }

  setupMobileSidebar();
  document.addEventListener('astro:page-load', setupMobileSidebar);
</script>

<style>
  /* ── Mobile Header (Hidden on Desktop) ── */
  .mobile-header {
    display: none;
  }

  .sidebar-backdrop {
    display: none;
  }

  .sidebar-drawer-header {
    display: none;
  }

  /* ── Desktop Sidebar ── */
  .sidebar {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow-y: auto;
    padding: 25px;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--bg);
  }

  /* Identity */
  .sidebar-identity { display: flex; flex-direction: column; gap: 8px; }

  .avatar-link { display: block; width: fit-content; }
  .avatar {
    display: block;
    border-radius: 6px;
    background: #f6f2e9;
    border: 1px solid #dfd7ca;
    object-fit: cover;
  }

  .identity-name { display: flex; flex-direction: column; text-decoration: none; }
  .name-main {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }
  .name-aka {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 400;
    letter-spacing: 0.6px;
  }
  .identity-name:hover .name-main { color: var(--text-link); }

  /* Social */
  .sidebar-social { display: flex; gap: 12px; align-items: center; }
  .sidebar-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: color var(--transition);
  }
  .sidebar-social a::after {
    display: none !important;
    content: none !important;
  }
  .sidebar-social a:hover { color: var(--text-link); text-decoration: none; }
  .sidebar-social svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  /* Nav */
  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .sidebar-nav a {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--text-secondary);
    display: block;
    padding: 3px 0;
    transition: color var(--transition);
    line-height: 1.4;
  }
  .sidebar-nav a:hover,
  .sidebar-nav a.active { color: var(--text-primary); text-decoration: none; }
  .sidebar-nav a.active { font-weight: 700; }

  .source-item {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
  }
  .source-link { color: var(--text-muted) !important; font-style: italic; font-size: var(--text-sm) !important; }
  .source-link:hover { color: var(--text-link) !important; }

  /* ── Mobile View (<= 768px) ── */
  @media (max-width: 768px) {
    .mobile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0 16px;
      height: 50px;
    }

    .mobile-header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .mobile-menu-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 6px;
      color: var(--text-primary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease, border-color 0.15s ease;
      line-height: 1;
    }
    .mobile-menu-btn:hover {
      background: #eee;
      border-color: var(--border-hover);
    }

    .mobile-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }
    .mobile-avatar {
      border-radius: 4px;
      border: 1px solid #dfd7ca;
      background: #f6f2e9;
      object-fit: cover;
      display: block;
    }
    .mobile-brand-name {
      font-family: var(--font-sans);
      font-size: var(--text-md);
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1;
    }
    .mobile-brand:hover .mobile-brand-name {
      color: var(--text-link);
    }

    .mobile-header-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .mobile-toc-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 5px 10px;
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
      line-height: 1;
    }
    .mobile-toc-btn:hover,
    .mobile-toc-btn[aria-expanded="true"] {
      color: var(--text-primary);
      border-color: var(--border-hover);
      background: #eee;
    }

    /* Mobile Drawer Backdrop */
    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(2px);
      z-index: 998;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    .sidebar-backdrop.open {
      opacity: 1;
      visibility: visible;
    }

    /* Mobile Drawer Aside */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(280px, 85vw);
      height: 100dvh;
      background: var(--bg);
      border-right: 1px solid var(--border);
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
      transform: translateX(-100%);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 999;
      padding: 16px 20px 24px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .sidebar.open {
      transform: translateX(0);
    }

    /* Drawer Header */
    .sidebar-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-drawer-title {
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
    }
    .sidebar-close-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      padding: 4px;
      cursor: pointer;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease, background 0.15s ease;
    }
    .sidebar-close-btn:hover {
      color: var(--text-primary);
      background: var(--bg-surface);
    }

    .sidebar-identity {
      gap: 8px;
    }
    .avatar {
      width: 56px;
      height: 56px;
    }

    .sidebar-nav a {
      padding: 6px 0;
      font-size: var(--text-base);
    }
  }
</style>
