---
import '../styles/global.css';
import { url } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'A minimalist digital garden and engineering blog.',
  image = '/og-default.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://netologist.github.io/breath/');
const siteName = 'Breath';
const faviconUrl = url('/favicon.svg');
const rssUrl = url('/rss.xml');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title === siteName ? `${title} — Digital Garden & Engineering Blog` : `${title} — ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Doe" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title={siteName} href={rssUrl} />
  </head>
  <body>
    <div class="site-layout">
      <slot />
    </div>

    <!-- ═══ EXTERNAL LINK PREVIEW PANEL (OG metadata card, site-wide) ═══
         See ADR-002. Owned by BaseLayout so every page gets the preview. -->
    <div id="ext-panel" class="ext-panel" aria-hidden="true" aria-label="External link preview">
      <div class="ext-panel-header">
        <div class="ext-panel-meta">
          <img id="ext-favicon" class="ext-favicon" src="" alt="" width="16" height="16" hidden />
          <span class="ext-panel-hostname" id="ext-panel-hostname"></span>
        </div>
        <div class="ext-panel-actions">
          <a id="ext-newtab-btn" href="#" target="_blank" rel="noopener noreferrer" class="ext-newtab-btn">
            Open in New Tab ↗
          </a>
          <button id="ext-panel-close" class="ext-panel-close" aria-label="Close preview">✕</button>
        </div>
      </div>
      <div class="ext-panel-body">
        <div id="ext-loading" class="ext-loading">Loading link preview…</div>
        <div id="ext-card" class="ext-card" hidden>
          <div class="ext-card-image-wrap" id="ext-image-wrap" hidden>
            <img id="ext-image" class="ext-card-image" src="" alt="" loading="lazy" />
          </div>
          <div class="ext-card-content">
            <h3 id="ext-title" class="ext-card-title"></h3>
            <p id="ext-desc" class="ext-card-desc"></p>
            <div class="ext-card-url-row">
              <span class="ext-card-favicon" id="ext-card-favicon-wrap" hidden>
                <img id="ext-card-favicon" src="" alt="" width="14" height="14" />
              </span>
              <span id="ext-url" class="ext-card-url"></span>
            </div>
          </div>
        </div>
        <div id="ext-fallback" class="ext-fallback" hidden>
          <p class="ext-fallback-text">No preview metadata available.</p>
          <a id="ext-fallback-link" href="#" target="_blank" rel="noopener noreferrer" class="ext-open-btn">
            Open in New Tab ↗
          </a>
        </div>
      </div>
    </div>

<!-- ════════════════════════════════════════════════════════
     SITE-WIDE LINK ENGINE (ADR-002)
     - External link ↗ indicator
     - OG metadata preview panel for external links
     ════════════════════════════════════════════════════════ -->
<script>
(function () {
  // ── Base path detection ──
  const BASE = window.location.pathname.startsWith('/breath') ? '/breath' : '';

  // ──────────────────────────────────────────────────
  // 1. External link ↗ indicator
  //    Marks every outbound link with class "ext-link";
  //    CSS renders the ↗ arrow via ::after.
  //    Embedded media links (.embed-link) are excluded.
  // ──────────────────────────────────────────────────
  function markExternalLinks() {
    const ownHost = window.location.host;
    document.querySelectorAll('a[href]').forEach((a) => {
      if (a.classList.contains('ext-link') || a.classList.contains('embed-link')) return;
      const href = a.getAttribute('href') || '';
      if (!/^https?:\/\//.test(href)) return;
      if (a.hasAttribute('data-astro-prefetch') || a.hasAttribute('data-astro-transition')) return;
      // Skip panel-internal buttons
      if (a.id === 'ext-newtab-btn' || a.id === 'ext-fallback-link') return;
      try {
        if (new URL(href).host === ownHost) return; // same-site absolute link
      } catch {
        return;
      }
      a.classList.add('ext-link');
    });
  }

  // Expose for layouts that inject content after load (NoteLayout trail)
  (window as any).__markExternalLinks = markExternalLinks;

  // ──────────────────────────────────────────────────
  // 2. External link preview panel (OG metadata card)
  // ──────────────────────────────────────────────────
  const extPanel      = document.getElementById('ext-panel')!;
  const extHostname   = document.getElementById('ext-panel-hostname')!;
  const extNewtab     = document.getElementById('ext-newtab-btn') as HTMLAnchorElement;
  const extClose      = document.getElementById('ext-panel-close')!;
  const extLoading    = document.getElementById('ext-loading')!;
  const extCard       = document.getElementById('ext-card')!;
  const extTitle      = document.getElementById('ext-title')!;
  const extDesc       = document.getElementById('ext-desc')!;
  const extUrl        = document.getElementById('ext-url')!;
  const extFavicon    = document.getElementById('ext-favicon') as HTMLImageElement;
  const extImage      = document.getElementById('ext-image') as HTMLImageElement;
  const extImageWrap  = document.getElementById('ext-image-wrap')!;
  const extCardFav    = document.getElementById('ext-card-favicon') as HTMLImageElement;
  const extCardFavW   = document.getElementById('ext-card-favicon-wrap')!;
  const extFallback   = document.getElementById('ext-fallback')!;
  const extFallbackLk = document.getElementById('ext-fallback-link') as HTMLAnchorElement;

  let ogCache: Record<string, any> | null = null;

  async function loadOgCache() {
    if (ogCache) return ogCache;
    try {
      const res = await fetch(`${BASE}/og-cache.json`);
      ogCache = res.ok ? await res.json() : {};
    } catch {
      ogCache = {};
    }
    return ogCache;
  }

  function showPanel() {
    extPanel.setAttribute('aria-hidden', 'false');
    extPanel.classList.add('open');
    document.body.classList.add('ext-open');
  }

  function openExtPanel(href: string) {
    let hostname = href;
    try { hostname = new URL(href).hostname; } catch {}
    extHostname.textContent = hostname;
    extNewtab.href = href;
    extFallbackLk.href = href;
    extFavicon.hidden = true;
    extLoading.hidden = false;
    extCard.hidden = true;
    extFallback.hidden = true;
    showPanel();

    loadOgCache().then(cache => {
      const meta = cache?.[href];
      if (meta && (meta.title || meta.description)) {
        extLoading.hidden = true;
        extCard.hidden = false;
        extTitle.textContent = meta.title || hostname;
        extDesc.textContent = meta.description || '';
        extDesc.hidden = !meta.description;
        extUrl.textContent = href.length > 80 ? href.slice(0, 80) + '…' : href;
        if (meta.image) {
          extImage.src = meta.image;
          extImageWrap.hidden = false;
        } else {
          extImageWrap.hidden = true;
        }
        if (meta.favicon) {
          extCardFav.src = meta.favicon;
          extCardFavW.hidden = false;
        } else {
          extCardFavW.hidden = true;
        }
      } else {
        extLoading.hidden = true;
        extFallback.hidden = false;
      }
    });
  }

  function closeExtPanel() {
    extPanel.classList.remove('open');
    extPanel.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('ext-open');
  }

  extClose.addEventListener('click', closeExtPanel);

  // ──────────────────────────────────────────────────
  // Link click interception (capture phase, runs before
  // ClientRouter and before NoteLayout's re-root handler).
  // External links → preview panel; everything else passes through.
  // ──────────────────────────────────────────────────
  document.addEventListener('click', (e: MouseEvent) => {
    if (window.innerWidth <= 768) return; // mobile: normal navigation
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    const href = a.getAttribute('href') || '';
    if (!href || href.startsWith('#') || href.startsWith('mailto:')) return;
    // Panel's own buttons must navigate normally
    if (a.id === 'ext-newtab-btn' || a.id === 'ext-fallback-link' || a.classList.contains('ext-open-btn')) return;
    // Embedded media links: default behavior (open in new tab / navigate)
    if (a.classList.contains('embed-link')) return;
    if (a.hasAttribute('data-astro-prefetch') || a.hasAttribute('data-astro-transition')) return;

    // External link → OG preview panel
    if (/^https?:\/\//.test(href)) {
      try {
        if (new URL(href).host === window.location.host) return; // same-site
      } catch {
        return;
      }
      e.preventDefault();
      e.stopPropagation();
      openExtPanel(href);
    }
  }, true);

  // ── Keyboard: Escape closes the panel ──
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && extPanel.classList.contains('open')) {
      closeExtPanel();
    }
  });

  // ── Boot: mark links + attach after every navigation ──
  function boot() {
    markExternalLinks();
  }
  boot();
  document.addEventListener('astro:page-load', () => boot());
})();
</script>
  </body>
</html>



<!-- Body lock while preview panel is open -->
<style is:global>
  body.ext-open {
    overflow: hidden;
    height: 100dvh;
  }
</style>

<style is:global>
  /* External link ↗ indicator */
  .ext-link::after {
    content: '↗';
    display: inline-block;
    margin-left: 2px;
    font-size: 0.72em;
    vertical-align: super;
    color: var(--text-muted);
    opacity: 0.7;
    transition: opacity var(--transition), transform var(--transition);
  }
  .ext-link:hover::after {
    opacity: 1;
    color: var(--text-link);
    transform: translate(1px, -1px);
  }

  /* ══════════════════════════════════════
     EXTERNAL LINK PANEL (OG card)
  ══════════════════════════════════════ */
  .ext-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(460px, 92vw);
    background: var(--bg);
    border-left: 1px solid var(--border);
    box-shadow: -6px 0 24px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2000;
    overflow: hidden;
  }
  .ext-panel.open { transform: translateX(0); }
  .ext-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-surface);
    gap: 8px;
    flex-shrink: 0;
  }
  .ext-panel-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .ext-favicon { border-radius: 2px; flex-shrink: 0; }
  .ext-panel-hostname {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ext-panel-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .ext-newtab-btn {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-link);
    text-decoration: none;
    font-weight: 500;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: background var(--transition), border-color var(--transition);
    white-space: nowrap;
  }
  .ext-newtab-btn:hover {
    background: var(--bg-surface);
    border-color: var(--border-hover);
    text-decoration: none;
  }
  .ext-panel-close {
    background: none;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    color: var(--text-muted);
    padding: 4px 6px;
    border-radius: 3px;
    line-height: 1;
    transition: background var(--transition), color var(--transition);
  }
  .ext-panel-close:hover { background: var(--border); color: var(--text-primary); }

  .ext-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }
  .ext-loading {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: 24px 0;
  }
  .ext-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-surface);
  }
  .ext-card-image-wrap { max-height: 220px; overflow: hidden; }
  .ext-card-image { width: 100%; height: auto; display: block; object-fit: cover; max-height: 220px; }
  .ext-card-content { padding: 14px 16px; }
  .ext-card-title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
    line-height: 1.3;
  }
  .ext-card-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 10px;
    line-height: 1.5;
  }
  .ext-card-url-row { display: flex; align-items: center; gap: 6px; }
  .ext-card-favicon { border-radius: 2px; flex-shrink: 0; }
  .ext-card-url {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ext-fallback { text-align: center; padding: 40px 20px; color: var(--text-secondary); }
  .ext-fallback-text {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    margin-bottom: 16px;
  }
  .ext-open-btn {
    display: inline-block;
    padding: 8px 20px;
    background: var(--text-primary);
    color: #fff;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius);
    text-decoration: none;
    transition: opacity var(--transition);
  }
  .ext-open-btn:hover { opacity: 0.85; text-decoration: none; color: #fff; }

  /* ══════════════════════════════════════
     MEDIA EMBEDS (rehype-embeds, ADR-002)
  ══════════════════════════════════════ */
  .embed-wrap {
    position: relative;
    width: 100%;
    margin: var(--space-lg) 0;
  }
  .embed-youtube {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .embed-youtube iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .embed-x iframe {
    width: 100%;
    min-height: 400px;
    border: none;
    border-radius: 4px;
    background: var(--bg-surface);
  }
  /* The paragraph holding a standalone embed link — no bottom margin so the
     embed below it sits tight. */
  .embed-paragraph {
    margin-bottom: 0 !important;
  }
  .embed-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    word-break: break-all;
  }
  .embed-link:hover {
    color: var(--text-link);
  }

  @media (max-width: 768px) {
    .ext-panel { width: 100vw; }
    .embed-x iframe { min-height: 320px; }
  }
</style>
