---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'A minimalist digital garden and engineering blog.',
  image = '/og-default.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://netologist.github.io/breath/');
const siteName = 'Breath';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title === siteName ? `${title} — Digital Garden & Engineering Blog` : `${title} — ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Doe" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
  </head>
  <body>
    <div class="site-layout">
      <slot />
    </div>
  </body>
</html>
