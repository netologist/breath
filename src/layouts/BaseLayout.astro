---
import '../styles/global.css';
import { siteConfig } from '../site.config';
import { url } from '../utils/url';
import MediaModal from '../components/MediaModal.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = siteConfig.site.description,
  image = siteConfig.site.defaultImage ?? '/og-default.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteConfig.site.url ?? 'https://netologist.github.io/breath/');
const siteName = siteConfig.site.title;
const faviconUrl = url('/favicon.svg');
const rssUrl = url('/rss.xml');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Zero-FOUT Theme Initialization: Sync from localStorage / Cookie / System preference -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (!stored) {
            var match = document.cookie.match(/(?:^|; )theme=([^;]+)/);
            if (match) stored = decodeURIComponent(match[1]);
          }
          var theme = stored;
          if (!theme || theme === 'auto' || theme === 'system') {
            theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
            document.documentElement.style.colorScheme = 'dark';
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
            document.documentElement.style.colorScheme = 'light';
          }
        } catch (e) {}
      })();
    </script>
    <!-- Instant Local Font Preloading (Zero FOUT / Zero Swap) -->
    <link rel="preload" href={url('/fonts/yanone-kaffeesatz-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/yanone-kaffeesatz-latin-600-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/yanone-kaffeesatz-latin-700-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/jetbrains-mono-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title === siteName ? `${title} — Digital Garden & Engineering Blog` : `${title} — ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title={siteName} href={rssUrl} />
  </head>
  <body>
    <div class="site-layout">
      <slot />
    </div>

    <!-- ═══ EXTERNAL LINK HOVER POPOVER (OG metadata card) ═══
         Non-intrusive floating card preview for external links in text. -->
    <div id="ext-popover" class="ext-popover" aria-hidden="true" role="tooltip">
      <a id="ext-popover-link" href="#" target="_blank" rel="noopener noreferrer" class="ext-popover-card">
        <div class="ext-popover-image-wrap" id="ext-pop-image-wrap" hidden>
          <img id="ext-pop-image" class="ext-popover-image" src="" alt="" loading="lazy" />
        </div>
        <div class="ext-popover-content">
          <div class="ext-popover-header">
            <span class="ext-popover-fav-wrap" id="ext-pop-fav-wrap" hidden>
              <img id="ext-pop-favicon" class="ext-popover-favicon" src="" alt="" width="14" height="14" />
            </span>
            <span class="ext-popover-hostname" id="ext-pop-hostname"></span>
            <svg class="ext-popover-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </div>
          <h4 id="ext-pop-title" class="ext-popover-title"></h4>
          <p id="ext-pop-desc" class="ext-popover-desc"></p>
        </div>
      </a>
    </div>

    <!-- Media Lightbox / Modal Box for Mermaid Diagrams & Images -->
    <MediaModal />

<!-- ════════════════════════════════════════════════════════
     SITE-WIDE LINK & MEDIA ENGINE
     - External link detection + new tab target
     - Non-intrusive hover preview popovers (OG metadata)
     - Twitter / X widgets auto-loader
     ════════════════════════════════════════════════════════ -->
<script>
(function () {
  // ── Base path detection ──
  const BASE = window.location.pathname.startsWith('/breath') ? '/breath' : '';

  // ──────────────────────────────────────────────────
  // Navigation origin tracker for breadcrumbs
  // ──────────────────────────────────────────────────
  try {
    const rawPath = window.location.pathname;
    let cleanPath = BASE && rawPath.startsWith(BASE) ? rawPath.slice(BASE.length) : rawPath;
    if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
    if (cleanPath.length > 1 && cleanPath.endsWith('/')) cleanPath = cleanPath.slice(0, -1);

    if (!cleanPath.startsWith('/blog/')) {
      sessionStorage.setItem('breath_nav_origin', cleanPath);
    }
  } catch (e) {}

  // ──────────────────────────────────────────────────
  // 1. External link target="_blank" & rel marker
  // ──────────────────────────────────────────────────
  function markExternalLinks() {
    const ownHost = window.location.host;
    document.querySelectorAll('a[href]').forEach((a) => {
      if (a.classList.contains('ext-link') || a.classList.contains('embed-link')) return;
      if (a.closest('.sidebar-social') || a.closest('.no-ext-icon') || a.classList.contains('no-ext-icon')) return;
      if (a.closest('#ext-popover')) return;
      const href = a.getAttribute('href') || '';
      if (!/^https?:\/\//.test(href)) return;
      if (a.hasAttribute('data-astro-prefetch') || a.hasAttribute('data-astro-transition')) return;
      try {
        if (new URL(href).host === ownHost) return; // same-site absolute link
      } catch {
        return;
      }
      a.classList.add('ext-link');
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    });
  }

  // Expose for layouts that inject content dynamically
  (window as any).__markExternalLinks = markExternalLinks;

  // ──────────────────────────────────────────────────
  // 2. External link hover popover (OG metadata card)
  // ──────────────────────────────────────────────────
  const popover = document.getElementById('ext-popover');
  const popoverLink = document.getElementById('ext-popover-link') as HTMLAnchorElement | null;
  const popoverImgWrap = document.getElementById('ext-pop-image-wrap');
  const popoverImg = document.getElementById('ext-pop-image') as HTMLImageElement | null;
  const popoverFavWrap = document.getElementById('ext-pop-fav-wrap');
  const popoverFav = document.getElementById('ext-pop-favicon') as HTMLImageElement | null;
  const popoverHostname = document.getElementById('ext-pop-hostname');
  const popoverTitle = document.getElementById('ext-pop-title');
  const popoverDesc = document.getElementById('ext-pop-desc');

  let ogCache: Record<string, any> | null = null;
  let showTimer: any = null;
  let hideTimer: any = null;
  let activeLink: HTMLElement | null = null;

  async function loadOgCache() {
    if (ogCache) return ogCache;
    try {
      const res = await fetch(`${BASE}/og-cache.json`);
      ogCache = res.ok ? await res.json() : {};
    } catch {
      ogCache = {};
    }
    return ogCache;
  }

  function decodeHtml(html: string) {
    const txt = document.createElement('textarea');
    txt.innerHTML = html;
    return txt.value;
  }

  function positionPopover(target: HTMLElement) {
    if (!popover) return;
    const rect = target.getBoundingClientRect();
    const popWidth = Math.min(340, window.innerWidth - 24);
    const popHeight = 220;

    let left = rect.left + rect.width / 2 - popWidth / 2;
    if (left + popWidth > window.innerWidth - 12) {
      left = window.innerWidth - popWidth - 12;
    }
    if (left < 12) left = 12;

    let top = rect.bottom + 8;
    if (rect.bottom + popHeight > window.innerHeight && rect.top > popHeight) {
      top = rect.top - popHeight - 8;
    }

    popover.style.left = `${left}px`;
    popover.style.top = `${top}px`;
    popover.style.width = `${popWidth}px`;
  }
  function showPopover(link: HTMLElement, href: string) {
    if (!popover || !popoverHostname || !popoverTitle || !popoverDesc || !popoverLink) return;
    clearTimeout(hideTimer);
    activeLink = link;

    let hostname = href;
    try { hostname = new URL(href).hostname; } catch {}
    popoverHostname.textContent = hostname;
    popoverLink.href = href;

    loadOgCache().then(cache => {
      if (activeLink !== link) return;
      const meta = cache?.[href];
      if (meta && (meta.title || meta.description)) {
        popoverTitle.textContent = meta.title ? decodeHtml(meta.title) : hostname;
        popoverDesc.textContent = meta.description ? decodeHtml(meta.description) : '';
        popoverDesc.hidden = !meta.description;
        if (meta.image && popoverImg && popoverImgWrap) {
          popoverImg.src = meta.image;
          popoverImgWrap.hidden = false;
        } else if (popoverImgWrap) {
          popoverImgWrap.hidden = true;
        }
        if (meta.favicon && popoverFav && popoverFavWrap) {
          popoverFav.src = meta.favicon;
          popoverFavWrap.hidden = false;
        } else if (popoverFavWrap) {
          popoverFavWrap.hidden = true;
        }
      } else {
        popoverTitle.textContent = hostname;
        popoverDesc.textContent = href;
        popoverDesc.hidden = false;
        if (popoverImgWrap) popoverImgWrap.hidden = true;
        if (popoverFavWrap) popoverFavWrap.hidden = true;
      }
      positionPopover(link);
      popover.classList.add('visible');
      popover.setAttribute('aria-hidden', 'false');
    });
  }

  function hidePopover() {
    if (!popover) return;
    popover.classList.remove('visible');
    popover.setAttribute('aria-hidden', 'true');
    activeLink = null;
  }

  document.addEventListener('mouseover', (e: MouseEvent) => {
    if (window.innerWidth <= 768) return;
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    if (a.closest('.sidebar-social') || a.closest('#sidebar')) return;
    if (a.closest('#ext-popover')) return;
    const href = a.getAttribute('href') || '';
    if (!/^https?:\/\//.test(href)) return;
    try {
      if (new URL(href).host === window.location.host) return;
    } catch { return; }

    clearTimeout(hideTimer);
    clearTimeout(showTimer);
    showTimer = setTimeout(() => {
      showPopover(a, href);
    }, 150);
  });

  document.addEventListener('mouseout', (e: MouseEvent) => {
    const related = e.relatedTarget as HTMLElement | null;
    if (related && (related.closest('#ext-popover') || related.closest('a') === activeLink)) {
      return;
    }
    clearTimeout(showTimer);
    hideTimer = setTimeout(() => {
      hidePopover();
    }, 180);
  });

  popover?.addEventListener('mouseenter', () => {
    clearTimeout(hideTimer);
  });

  popover?.addEventListener('mouseleave', () => {
    clearTimeout(showTimer);
    hideTimer = setTimeout(() => {
      hidePopover();
    }, 180);
  });

  // ──────────────────────────────────────────────────
  // ──────────────────────────────────────────────────
  // 3. Twitter / X widget loader with dark theme support
  // ──────────────────────────────────────────────────
  function isCurrentDarkTheme(): boolean {
    const doc = document.documentElement;
    if (doc.classList.contains('dark') || doc.getAttribute('data-theme') === 'dark') return true;
    if (doc.classList.contains('light') || doc.getAttribute('data-theme') === 'light') return false;
    try {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark') return true;
      if (stored === 'light') return false;
      const match = document.cookie.match(/(?:^|; )theme=([^;]+)/);
      if (match) return decodeURIComponent(match[1]) === 'dark';
    } catch (e) {}
    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function syncTwitterThemeAttributes(targetTheme?: 'dark' | 'light') {
    const theme = targetTheme || (isCurrentDarkTheme() ? 'dark' : 'light');
    document.querySelectorAll<HTMLElement>('.twitter-tweet').forEach((el) => {
      el.setAttribute('data-theme', theme);
    });
  }

  function loadTwitterWidgets() {
    if (!document.querySelector('.twitter-tweet') && !document.querySelector('.embed-x')) return;

    syncTwitterThemeAttributes();

    if ((window as any).twttr?.widgets) {
      (window as any).twttr.widgets.load();
      return;
    }
    if (document.getElementById('twitter-wjs')) return;
    const script = document.createElement('script');
    script.id = 'twitter-wjs';
    script.src = 'https://platform.twitter.com/widgets.js';
    script.async = true;
    script.charset = 'utf-8';
    document.head.appendChild(script);
  }

  function reloadTwitterWidgets(isDark?: boolean) {
    const embeds = document.querySelectorAll<HTMLElement>('.embed-x');
    if (!embeds.length) return;

    const dark = typeof isDark === 'boolean' ? isDark : isCurrentDarkTheme();
    const themeName = dark ? 'dark' : 'light';

    embeds.forEach((container) => {
      let tweetUrl = container.dataset.tweetUrl;
      if (!tweetUrl) {
        const a = container.querySelector<HTMLAnchorElement>('a');
        if (a && a.href) {
          tweetUrl = a.href;
          container.dataset.tweetUrl = tweetUrl;
        } else {
          const iframe = container.querySelector<HTMLIFrameElement>('iframe');
          if (iframe?.src) {
            const m = iframe.src.match(/id=(\d+)/);
            if (m) tweetUrl = `https://x.com/i/status/${m[1]}`;
          }
        }
      }
      if (!tweetUrl) return;

      container.innerHTML = `
        <blockquote class="twitter-tweet" data-theme="${themeName}" data-dnt="true">
          <a href="${tweetUrl}">${tweetUrl}</a>
        </blockquote>
      `;
    });

    if ((window as any).twttr?.widgets) {
      (window as any).twttr.widgets.load();
    } else {
      loadTwitterWidgets();
    }
  }

  // Listen for dynamic theme changes from ThemeToggle
  document.addEventListener('theme-changed', (e: any) => {
    const isDark = e?.detail?.isDark ?? isCurrentDarkTheme();
    reloadTwitterWidgets(isDark);
  });

  // ── Boot ──
  function boot() {
    markExternalLinks();
    loadTwitterWidgets();
  }
  boot();
  document.addEventListener('astro:page-load', () => boot());
})();
</script>
  </body>
</html>

<style is:global>
  /* ══════════════════════════════════════
     EXTERNAL LINK HOVER POPOVER CARD
  ══════════════════════════════════════ */
  .ext-popover {
    position: fixed;
    z-index: 3000;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.15));
  }
  .ext-popover.visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }

  .ext-popover-card {
    display: block;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition);
  }
  .ext-popover-card:hover {
    border-color: var(--border-hover);
    text-decoration: none;
  }

  .ext-popover-image-wrap {
    width: 100%;
    height: 120px;
    background: var(--bg-surface);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .ext-popover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ext-popover-content {
    padding: 10px 12px;
  }
  .ext-popover-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }
  .ext-popover-fav-wrap {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .ext-popover-favicon {
    width: 14px;
    height: 14px;
    border-radius: 2px;
  }
  .ext-popover-hostname {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }
  .ext-popover-arrow {
    font-size: var(--text-xs);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .ext-popover-title {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0 0 4px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ext-popover-card:hover .ext-popover-title {
    color: var(--text-link);
  }

  .ext-popover-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ══════════════════════════════════════
     MEDIA EMBEDS (rehype-embeds, ADR-002)
  ══════════════════════════════════════ */
  .embed-wrap {
    position: relative;
    width: 100%;
    margin: var(--space-lg) 0;
  }
  .embed-youtube {
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-surface);
  }
  .embed-youtube iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .embed-x {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: var(--space-lg) 0;
  }
  .embed-x .twitter-tweet {
    margin: 0 auto !important;
  }

  /* Ensure tweet widget iframe and container have seamless dark/light rounded corners with no white bleed */
  .embed-x .twitter-tweet-rendered,
  .embed-x iframe {
    border-radius: 13px !important;
    overflow: hidden !important;
    background-color: transparent !important;
    transform: translateZ(0);
  }

  /* Unrendered / loading fallback card for Twitter embed */
  .embed-x blockquote.twitter-tweet:not(.twitter-tweet-rendered) {
    display: block;
    max-width: 550px;
    width: 100%;
    margin: 0 auto;
    padding: 16px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .embed-x blockquote.twitter-tweet:not(.twitter-tweet-rendered) a {
    color: var(--text-link);
    text-decoration: none;
    word-break: break-all;
  }
  .embed-x blockquote.twitter-tweet:not(.twitter-tweet-rendered) a:hover {
    text-decoration: underline;
  }

  /* Dark theme overrides for external link popover and Twitter embeds */
  html.dark .embed-x iframe,
  [data-theme="dark"] .embed-x iframe {
    color-scheme: dark;
    background-color: transparent !important;
  }
  html.dark .embed-x .twitter-tweet-rendered,
  [data-theme="dark"] .embed-x .twitter-tweet-rendered {
    background-color: transparent !important;
  }
  html.dark .ext-popover,
  [data-theme="dark"] .ext-popover {
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.55));
  }
  html.dark .ext-popover-card,
  [data-theme="dark"] .ext-popover-card {
    background: var(--bg-surface);
    border-color: var(--border);
  }

  @media (max-width: 768px) {
    .ext-popover { display: none !important; }
  }
</style>
